{
  "mcpServers": {
    "stepstitch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "stepstitch-service[mcp]", "stepstitch", "mcp"],
      "env": {
        "STEPSTITCH_BASE_URL": "http://127.0.0.1:8321/api/stepstitch/v1",
        "STEPSTITCH_TOKEN_FILE": "${STEPSTITCH_TOKEN_FILE}"
      }
    }
  }
}
