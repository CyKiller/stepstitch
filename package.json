{
  "name": "@stepstitch/tracker",
  "version": "0.8.0",
  "description": "StepStitch \u2014 issue-to-repro infrastructure (not session replay): turns a user-reported problem into scrubbed diagnostics, a replayability score, and a copyable Playwright reproduction, without capturing screens, input values, or page text. Zero runtime dependencies.",
  "license": "Apache-2.0",
  "keywords": [
    "playwright",
    "session-replay",
    "bug-reproduction",
    "regression-testing",
    "reproducibility",
    "privacy",
    "redaction",
    "pii",
    "mcp",
    "model-context-protocol",
    "self-hosted",
    "observability",
    "qa",
    "evidence",
    "typescript",
    "zero-dependencies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyKiller/stepstitch.git"
  },
  "homepage": "https://stepstitch.vercel.app",
  "bugs": {
    "url": "https://github.com/CyKiller/stepstitch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "sbom.cdx.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/finalize-dist.mjs",
    "prepare": "node scripts/setup-githooks.mjs && npm run build",
    "prepublishOnly": "npm run build && npm run type-check && npm test",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "stamp": "node scripts/stamp-build.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "evidence": "PYTHONPATH=service python3 scripts/generate_compliance_evidence.py",
    "release": "npm run build && npm run stamp && npm run sbom",
    "test:e2e-proof": "node scripts/prove-repro-executes.mjs",
    "demo": "PYTHONPATH=service python3 scripts/demo_red_to_green.py",
    "smoke": "npm run demo && node scripts/smoke-check.mjs",
    "release-gate:evidence": "python3 -m pytest service/tests/test_repro_eval.py service/tests/test_compliance.py service/tests/test_golden_path.py -q",
    "demo:dataset": "PYTHONPATH=service python3 scripts/build_demo_dataset.py",
    "test:demo-console": "playwright test --config playwright.demo.config.ts",
    "test:runner-proof": "node scripts/prove-runner-executes.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
