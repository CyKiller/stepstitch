{
  "name": "@stepstitch/tracker",
  "version": "0.4.0",
  "description": "StepStitch — issue-to-repro infrastructure (not session replay): turns a user-reported problem into scrubbed diagnostics, a replayability score, and a copyable Playwright reproduction, without capturing screens, input values, or page text. Zero runtime dependencies.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "sbom.cdx.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "stamp": "node scripts/stamp-build.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "evidence": "PYTHONPATH=service python3 scripts/generate_compliance_evidence.py",
    "release": "npm run build && npm run stamp && npm run sbom",
    "test:e2e-proof": "node scripts/prove-repro-executes.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
