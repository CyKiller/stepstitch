#!/usr/bin/env bash
# Auto-strip AI co-author / "Generated with" trailers so history stays CyKiller-only.
# Runs on every commit; rewrites the message file in place.
set -euo pipefail

msg_file="$1"

# Remove Co-Authored-By: Claude/AI lines and "Generated with ..." lines,
# then collapse the resulting repeated blank lines.
sed -E \
  -e '/^[[:space:]]*Co-[Aa]uthored-[Bb]y:[[:space:]]*Claude/d' \
  -e '/^[[:space:]]*🤖[[:space:]]*Generated with/d' \
  -e '/^[[:space:]]*Generated with \[?Claude/d' \
  "$msg_file" | cat -s > "$msg_file.tmp"

mv "$msg_file.tmp" "$msg_file"
