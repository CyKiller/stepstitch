#!/usr/bin/env bash
# Optional pre-flight: run the fast CI checks (lint + type-check) for the surfaces being
# pushed, so a lint/type failure can't reach `main` and turn CI red. Vitest is NOT run here
# (it needs Node >=20.12 and is slower) — full tests stay in CI.
#
# This hook is opt-in — nothing installs it for you. Enable it with:
#   npm run hooks:install
# It checks code quality only. It has no opinion about who you are: identity and commit
# trailers are not this repository's business, and a hook that enforced one maintainer's
# name would reject every other contributor's commits.
#
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail

Z40="0000000000000000000000000000000000000000"
CHANGED=""        # accumulated changed paths across pushed ranges
CHECK_ALL=0       # 1 when a new branch is pushed (no cheap range) -> check everything

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$Z40" ] && continue  # branch deletion

  if [ "$remote_sha" = "$Z40" ]; then
    CHECK_ALL=1  # new branch: no cheap changed-path range, so check everything
  else
    range="${remote_sha}..${local_sha}"
    CHANGED="$CHANGED
$(git diff --name-only "$range" 2>/dev/null || true)"
  fi
done

# Scope to what's being pushed; only the cheap, deterministic gates (no vitest).
repo_root=$(git rev-parse --show-toplevel)
run_root_ts=0
run_web=0
if [ "$CHECK_ALL" -eq 1 ]; then
  run_root_ts=1; run_web=1
else
  if printf '%s\n' "$CHANGED" | grep -qE '^(src/|tests/|package\.json|tsconfig.*\.json|.+\.ts)$'; then
    run_root_ts=1
  fi
  if printf '%s\n' "$CHANGED" | grep -qE '^web/'; then
    run_web=1
  fi
fi

# The web toolchain (Next 16 / eslint-config-next) needs Node >=20. When the active node is
# older, best-effort pick the newest nvm-installed Node 20+/22 just for these checks so the
# gate works from a default-Node-18 shell. Falls back to warn-skip (never a false block).
ensure_modern_node() {
  local major newest
  major=$(node -v 2>/dev/null | sed -E 's/^v([0-9]+).*/\1/' || true)
  if [ -n "${major:-}" ] && [ "$major" -ge 20 ] 2>/dev/null; then return 0; fi
  newest=$(ls -d "$HOME"/.nvm/versions/node/v2[0-9]* 2>/dev/null | sort -V | tail -1 || true)
  if [ -n "$newest" ] && [ -x "$newest/bin/node" ]; then
    PATH="$newest/bin:$PATH"; export PATH
    return 0
  fi
  return 1
}

preflight_fail=0

if [ "$run_root_ts" -eq 1 ]; then
  echo "▶ pre-push: root type-check (tsc)…" >&2
  if ! ( cd "$repo_root" && npm run --silent type-check >/dev/null 2>&1 ); then
    echo "✗ root type-check failed — run: npm run type-check" >&2
    preflight_fail=1
  fi
fi

if [ "$run_web" -eq 1 ]; then
  if [ ! -d "$repo_root/web/node_modules" ]; then
    echo "⚠ web/ changed but web/node_modules is missing — skipping web lint/type-check." >&2
    echo "  Run 'cd web && npm ci' to enable the local gate; CI still enforces it." >&2
  elif ! ensure_modern_node; then
    echo "⚠ web/ changed but no Node >=20 found (active: $(node -v 2>/dev/null || echo none))." >&2
    echo "  Skipping web lint/type-check locally; push from a Node 20+ shell to gate it. CI still enforces it." >&2
  else
    echo "▶ pre-push: web lint + type-check (Node $(node -v))…" >&2
    if ! ( cd "$repo_root/web" && npm run --silent lint >/dev/null 2>&1 ); then
      echo "✗ web lint (eslint) failed — run: cd web && npm run lint" >&2
      preflight_fail=1
    fi
    if ! ( cd "$repo_root/web" && npx --no-install tsc --noEmit >/dev/null 2>&1 ); then
      echo "✗ web type-check failed — run: cd web && npx tsc --noEmit" >&2
      preflight_fail=1
    fi
  fi
fi

if [ "$preflight_fail" -ne 0 ]; then
  echo "" >&2
  echo "Push blocked by pre-flight checks above. Fix them (or, only if you must, bypass with: git push --no-verify)." >&2
  exit 1
fi
