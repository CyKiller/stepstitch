#!/usr/bin/env bash
# Safety net: refuse to push any commit that isn't authored AND committed by
# CyKiller <cykiller@msn.com>, or that still carries an AI co-author trailer.
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail

EXPECTED_EMAIL="cykiller@msn.com"
EXPECTED_NAME="CyKiller"
Z40="0000000000000000000000000000000000000000"
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$Z40" ] && continue  # branch deletion

  if [ "$remote_sha" = "$Z40" ]; then
    range="$local_sha"                    # new branch: check all reachable commits
    rev_args="$local_sha --not --remotes"
  else
    range="${remote_sha}..${local_sha}"
    rev_args="$range"
  fi

  for sha in $(git rev-list $rev_args); do
    an=$(git show -s --format='%an' "$sha")
    ae=$(git show -s --format='%ae' "$sha" | tr '[:upper:]' '[:lower:]')
    cn=$(git show -s --format='%cn' "$sha")
    ce=$(git show -s --format='%ce' "$sha" | tr '[:upper:]' '[:lower:]')
    body=$(git show -s --format='%B' "$sha")

    if [ "$ae" != "$EXPECTED_EMAIL" ] || [ "$an" != "$EXPECTED_NAME" ] \
       || [ "$ce" != "$EXPECTED_EMAIL" ] || [ "$cn" != "$EXPECTED_NAME" ]; then
      echo "✗ $sha has wrong identity: author='$an <$ae>' committer='$cn <$ce>'" >&2
      echo "  expected '$EXPECTED_NAME <$EXPECTED_EMAIL>' for both." >&2
      fail=1
    fi

    if printf '%s' "$body" | grep -qiE 'Co-[Aa]uthored-[Bb]y:[[:space:]]*Claude|Generated with \[?Claude|🤖'; then
      echo "✗ $sha still has an AI co-author / 'Generated with' trailer." >&2
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'EOF'

Push blocked: history must be CyKiller <cykiller@msn.com> only.
Fix the offending commit(s), e.g.:
  git commit --amend --reset-author     # fix the latest commit's identity
  git rebase -i <base> --exec 'git commit --amend --reset-author --no-edit'
EOF
  exit 1
fi
