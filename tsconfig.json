{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  // The doc-examples and e2e suites need node builtins (fs, child_process); they
  // type-check under their own projects (tests/doc-examples/tsconfig.json,
  // tests/e2e/tsconfig.json, chained in the type-check script) so THIS project
  // keeps "types": [] — the SDK and its browser tests must never quietly start
  // depending on node globals.
  "exclude": ["tests/doc-examples.test.ts", "tests/doc-examples", "tests/e2e"]
}
