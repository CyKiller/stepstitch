{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  // The doc-examples suite needs node builtins (fs, child_process); it type-checks
  // under its own project (tests/doc-examples/tsconfig.json, chained in the
  // type-check script) so THIS project keeps "types": [] — the SDK and its browser
  // tests must never quietly start depending on node globals.
  "exclude": ["tests/doc-examples.test.ts", "tests/doc-examples"]
}
