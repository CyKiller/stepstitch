# StepStitch ingest host — environment template.
# Copy to `server/.env` and fill in. See docs/DEPLOY.md for the full reference.
# Run with: uvicorn server.app:app  (migrations apply automatically on startup).

# --- Required ---------------------------------------------------------------

# Postgres connection (asyncpg DSN). Migrations use the same URL over psycopg2.
DATABASE_URL=postgresql://stepstitch:stepstitch@localhost:5432/stepstitch

# Shared bearer token for trace ingestion (writes). Use a long random value.
STEPSTITCH_INGEST_TOKEN=replace-with-a-long-random-secret

# Shared bearer token for operator reads/destructive ops. Required UNLESS OIDC
# is configured below (STEPSTITCH_OIDC_ISSUER set), which supersedes it.
STEPSTITCH_ADMIN_TOKEN=replace-with-a-different-long-random-secret

# --- Posture & retention (optional; safe defaults shown) --------------------

# Scrub profile. May only TIGHTEN privacy. Default is the strictest FI posture.
# Options: financial-services-enterprise | healthcare-strict | internal-enterprise | open-source-default
STEPSTITCH_PROFILE=financial-services-enterprise

# Inject the built-in (Apache-2.0) draft adapters. 1/true/yes to enable.
STEPSTITCH_ENABLE_ADAPTERS=1

# Trace-body retention window in days (audit records keep a separate longer clock).
RETENTION_DAYS=30

# Background auto-purge interval in seconds. 0 disables the loop (operators who
# prefer the admin-triggered POST /api/maintenance/purge-expired endpoint only).
RETENTION_PURGE_INTERVAL_SECONDS=3600

# --- Operator SSO via OIDC (optional) ---------------------------------------
# Set STEPSTITCH_OIDC_ISSUER to switch operator auth from the shared admin token
# to per-operator JWTs (RS256/JWKS) with role-based access control.

# STEPSTITCH_OIDC_ISSUER=https://login.example.com/
# STEPSTITCH_OIDC_AUDIENCE=stepstitch-api
# STEPSTITCH_OIDC_JWKS_URI=                       # optional; else discovered from the issuer
# STEPSTITCH_OIDC_OPERATOR_ROLES=stepstitch-operator   # read surface (comma-separated)
# STEPSTITCH_OIDC_ADMIN_ROLES=stepstitch-admin         # destructive ops (comma-separated)
# STEPSTITCH_OIDC_ROLES_CLAIM=roles                     # JWT claim holding roles

# --- Tests only -------------------------------------------------------------
# Point the real-Postgres integration test at a throwaway DB to activate it
# (it self-skips when unset). CI sets this to its postgres service.
# STEPSTITCH_TEST_DATABASE_URL=postgresql://stepstitch:stepstitch@localhost:5432/stepstitch_ci
