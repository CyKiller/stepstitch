node_modules/
dist/
.venv/
coverage/
*.log
.DS_Store

# Local secrets — the .env.example template is committed, real .env files are not.
.env
.env.*
!.env.example
# Registry and key material. None of this has ever been committed; these rules exist so a
# stray `npm login` or a downloaded signing key cannot become the first time.
.npmrc
.pypirc
*.pem
*.key
*.p12
*.pfx
id_rsa*

__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.stepstitch-proof/
.stepstitch-runner-proof/
# `stepstitch start` local store + the runner's in-project scratch dirs
.stepstitch/
test-results/
playwright-report/

# Local tooling & build artifacts (keep the repo professional)
.agents/
service/build/
skills-lock.json
# Editor/assistant workspace config is personal to each machine and never published.
# No negation here on purpose: nothing under .claude/ belongs in a public repo, and an
# exception is how a local file with real paths or tokens gets committed by accident.
.claude/

# Git hooks are per-clone local tooling, like .claude/ above. A hook that ships in the
# repository runs other people's code on their machine on every push, and `core.hooksPath`
# is a local setting anyway — so keep hooks in your own global config, not here.
.githooks/

# Superpowers brainstorm scratch (visual companion mockups)
.superpowers/

# TinyTransfer example: scratch dir for the red-to-green verify run
examples/tiny-transfer/.verify-run/
.stepstitch-agent-demo/
