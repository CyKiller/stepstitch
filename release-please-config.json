{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@stepstitch/tracker",
      "include-component-in-tag": false,
      "extra-files": [
        "src/tracker.ts",
        "service/pyproject.toml",
        "web/src/lib/version.ts",
        "docs/STATUS.md",
        {
          "type": "json",
          "path": "service/server.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "service/server.json",
          "jsonpath": "$.packages[0].version"
        },
        {
          "type": "json",
          "path": "packages/cli-shim/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/cli-shim/package.json",
          "jsonpath": "$.stepstitch.serviceVersion"
        }
      ]
    }
  }
}
