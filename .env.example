# StepStitch ingest host — environment template.
# Copy to .env and fill in. Never commit a real .env. See docs/DEPLOY.md for details.
# The credential-free demo (`npm run demo` / `npm run smoke`) needs NONE of these.

# --- Required ---------------------------------------------------------------
# Postgres connection string for the ingest service.
DATABASE_URL=postgres://localhost:5432/stepstitch
# Bearer token the SDK uses to POST traces to /session.
STEPSTITCH_INGEST_TOKEN=replace-with-a-long-random-ingest-token
# Bearer token for admin/operator reads, the cockpit, and dry-run drafts.
STEPSTITCH_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# --- Common (have sensible defaults) ----------------------------------------
# Scrub profile. May only tighten the boundary: financial-services-enterprise (default),
# healthcare-strict, internal-enterprise, open-source-default.
STEPSTITCH_PROFILE=financial-services-enterprise
# Days a trace body is retained before /maintenance/purge-expired removes it.
RETENTION_DAYS=30
# Background retention-purge loop interval (seconds).
RETENTION_PURGE_INTERVAL_SECONDS=3600
# Mount the bundled draft adapters (ServiceNow/Salesforce/Genesys). 1/true to enable.
STEPSTITCH_ENABLE_ADAPTERS=1

# --- Optional: per-operator SSO (OIDC) for admin reads ----------------------
# When set, admin endpoints accept OIDC access tokens in addition to the admin bearer.
# STEPSTITCH_OIDC_ISSUER=https://login.example.com/
# STEPSTITCH_OIDC_AUDIENCE=stepstitch
# STEPSTITCH_OIDC_JWKS_URI=https://login.example.com/.well-known/jwks.json
# STEPSTITCH_OIDC_ROLES_CLAIM=roles

# --- Optional: demo/marketing site live wiring (web/) -----------------------
# When set, the web live-demo proxies a real sanitized trace; otherwise it shows a sample.
# STEPSTITCH_BASE_URL=https://your-railway-app.up.railway.app
# STEPSTITCH_DEMO_TRACE_ID=
